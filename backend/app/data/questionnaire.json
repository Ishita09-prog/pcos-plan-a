{
  "meta": {
    "title": "PCOS/PMOS Phenotype Grouped Questionnaire & Diagnostic Scoring",
    "source_document": "PCOS_Phenotype_Grouped_Questionnaire_v3.1.docx",
    "version": "1.0.0"
  },
  "demographics": [
    {
      "id": "full_name",
      "label": "Full Name",
      "type": "text",
      "source": "Section 1, Row 1"
    },
    {
      "id": "date_of_birth",
      "label": "Date of Birth",
      "type": "date",
      "source": "Section 1, Row 1"
    },
    {
      "id": "age",
      "label": "Age",
      "type": "number",
      "source": "Section 1, Row 2"
    },
    {
      "id": "sex",
      "label": "Biological Sex / Gender Identification",
      "type": "select",
      "options": [
        "Female",
        "Male",
        "Intersex",
        "Prefer to self-describe"
      ],
      "source": "Section 1, Row 2"
    },
    {
      "id": "occupation",
      "label": "Current Occupation & Shift Schedule (e.g., night shifts, desk job)",
      "type": "text",
      "source": "Section 1, Row 3"
    },
    {
      "id": "relationship_status",
      "label": "Marital / Relationship Status & Pregnancy Goals",
      "type": "text",
      "source": "Section 1, Row 4"
    },
    {
      "id": "ethnicity",
      "label": "Ethnicity / Geographic Origin",
      "type": "text",
      "source": "Section 1, Row 5"
    },
    {
      "id": "living_environment",
      "label": "Current Living Environment",
      "type": "select",
      "options": [
        "Urban",
        "Industrial",
        "Agricultural",
        "High pollutant exposure",
        "Rural / low exposure"
      ],
      "source": "Section 1, Row 6"
    },
    {
      "id": "pcos_diagnosis_age",
      "label": "When was PCOS diagnosed (age)?",
      "type": "number",
      "source": "Section 1, Row 8"
    },
    {
      "id": "irregular_cycle_flag",
      "label": "Do you have an irregular menstrual cycle?",
      "type": "yesno",
      "source": "Section 1, Row 9"
    },
    {
      "id": "region_preference",
      "label": "Dietary region preference",
      "type": "select",
      "options": [
        "South Indian",
        "North Indian"
      ],
      "source": "Section 4 header (Targeted South Indian & North Indian Nutrition Guidelines)"
    },
    {
      "id": "diet_type",
      "label": "Diet type",
      "type": "select",
      "options": [
        "Vegetarian",
        "Non-Vegetarian",
        "Vegan"
      ],
      "source": "Section 4, Table 9 header (Veg / Non-Veg / Vegan plans)"
    }
  ],
  "primary_goals": [
    "Regularize menstrual cycles",
    "Eliminate adult acne",
    "Reduce hirsutism / excess facial hair",
    "Reverse insulin resistance",
    "Lower fasting glucose & HOMA-IR",
    "Normalize androgen levels (Testosterone / DHEA-S)",
    "Optimize ovulation & fertility",
    "Prepare for pregnancy",
    "Overcome chronic fatigue & brain fog",
    "Improve sleep quality",
    "Manage central abdominal weight",
    "Reduce chronic bloating & gut issues",
    "Balance mood & lower stress levels",
    "Boost mitochondrial energy & stamina"
  ],
  "phenotypes": {
    "adrenal": {
      "label": "Adrenal PCOS (Stress-Driven)",
      "source": "Section 2, Table 1",
      "questions": [
        {
          "id": "adrenal_vitals",
          "category": "Clinical Evaluation",
          "label": "Blood Pressure, Resting Heart Rate & SpO2",
          "reference": "120/80 mmHg / 60-75 bpm / >95%",
          "fields": [
            {
              "key": "systolic",
              "label": "Systolic BP",
              "type": "number",
              "unit": "mmHg"
            },
            {
              "key": "diastolic",
              "label": "Diastolic BP",
              "type": "number",
              "unit": "mmHg"
            },
            {
              "key": "heart_rate",
              "label": "Resting Heart Rate",
              "type": "number",
              "unit": "bpm"
            },
            {
              "key": "spo2",
              "label": "SpO2",
              "type": "number",
              "unit": "%"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "outside",
                "field": "systolic",
                "range": [
                  90,
                  120
                ]
              },
              {
                "op": "outside",
                "field": "diastolic",
                "range": [
                  60,
                  80
                ]
              },
              {
                "op": "outside",
                "field": "heart_rate",
                "range": [
                  60,
                  75
                ]
              },
              {
                "op": "lt",
                "field": "spo2",
                "value": 95
              }
            ]
          }
        },
        {
          "id": "adrenal_dheas",
          "category": "Biochemical Evaluation",
          "label": "DHEA-S (Dehydroepiandrosterone Sulfate)",
          "reference": "100-250 \u00b5g/dL (isolated >350 = Adrenal)",
          "fields": [
            {
              "key": "dhea_s",
              "label": "DHEA-S",
              "type": "number",
              "unit": "\u00b5g/dL"
            }
          ],
          "rule": {
            "op": "outside",
            "field": "dhea_s",
            "range": [
              100,
              250
            ]
          }
        },
        {
          "id": "adrenal_cortisol",
          "category": "Biochemical Evaluation",
          "label": "Fasting Cortisol (AM) / Salivary Cortisol Curve",
          "reference": "10-20 \u00b5g/dL (AM)",
          "fields": [
            {
              "key": "cortisol_am",
              "label": "AM Cortisol",
              "type": "number",
              "unit": "\u00b5g/dL"
            }
          ],
          "rule": {
            "op": "outside",
            "field": "cortisol_am",
            "range": [
              10,
              20
            ]
          }
        },
        {
          "id": "adrenal_stress",
          "category": "Root Cause Analysis",
          "label": "Chronic Stress & Anxiety Levels (scale 1-10; burnout history)",
          "reference": "Score < 4; no history of burnout",
          "fields": [
            {
              "key": "stress_scale",
              "label": "Stress/anxiety (1-10)",
              "type": "scale",
              "min": 1,
              "max": 10
            },
            {
              "key": "burnout_history",
              "label": "History of burnout?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "gte",
                "field": "stress_scale",
                "value": 4
              },
              {
                "op": "eq",
                "field": "burnout_history",
                "value": "yes"
              }
            ]
          }
        },
        {
          "id": "adrenal_sleep",
          "category": "Root Cause Analysis",
          "label": "Sleep Duration & Quality (onset, awakenings, wake time)",
          "reference": "7-9 hours continuous sleep",
          "fields": [
            {
              "key": "sleep_hours",
              "label": "Average sleep (hours)",
              "type": "number",
              "unit": "hrs",
              "min": 0,
              "max": 14,
              "step": 0.5
            },
            {
              "key": "sleep_poor_quality",
              "label": "Frequent awakenings / poor quality sleep?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "outside",
                "field": "sleep_hours",
                "range": [
                  7,
                  9
                ]
              },
              {
                "op": "eq",
                "field": "sleep_poor_quality",
                "value": "yes"
              }
            ]
          }
        },
        {
          "id": "adrenal_fatigue",
          "category": "Root Cause Analysis",
          "label": "Fatigue (feeling worn out easily)",
          "reference": "Feeling worn out easily",
          "fields": [
            {
              "key": "adrenal_fatigue",
              "label": "Do you feel worn out easily?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "adrenal_fatigue",
            "value": "yes"
          }
        },
        {
          "id": "adrenal_worried",
          "category": "Root Cause Analysis",
          "label": "Worried (about past, future, health)",
          "reference": "About past, future, health",
          "fields": [
            {
              "key": "worried",
              "label": "Do you feel frequently worried?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "worried",
            "value": "yes"
          }
        },
        {
          "id": "adrenal_concentration",
          "category": "Root Cause Analysis",
          "label": "Poor concentration",
          "reference": "Inability to focus long",
          "fields": [
            {
              "key": "poor_concentration",
              "label": "Poor concentration / hard to focus?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "poor_concentration",
            "value": "yes"
          }
        },
        {
          "id": "adrenal_breathing",
          "category": "Root Cause Analysis",
          "label": "Shallow breathing",
          "reference": "Chest breathing > 20 cycles/min",
          "fields": [
            {
              "key": "shallow_breathing",
              "label": "Shallow / chest breathing?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "shallow_breathing",
            "value": "yes"
          }
        },
        {
          "id": "adrenal_moods",
          "category": "Root Cause Analysis",
          "label": "Frequent mood swings",
          "reference": "Sudden irritability, anger, or mood drops",
          "fields": [
            {
              "key": "mood_swings",
              "label": "Frequent mood swings?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "mood_swings",
            "value": "yes"
          }
        }
      ]
    },
    "hormonal": {
      "label": "Hormonal PCOS (Ovarian / Post-Pill)",
      "source": "Section 2, Table 2",
      "questions": [
        {
          "id": "hormonal_cycle",
          "category": "Clinical Evaluation",
          "label": "Menstrual Cycle Length & Regularity",
          "reference": "Regular 21-35 day ovulatory cycles (abnormal > 45 days)",
          "fields": [
            {
              "key": "cycle_length_days",
              "label": "Average cycle length (days)",
              "type": "number",
              "unit": "days"
            },
            {
              "key": "cycle_absent",
              "label": "Are periods absent (amenorrhea) for over 45 days?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "outside",
                "field": "cycle_length_days",
                "range": [
                  21,
                  35
                ]
              },
              {
                "op": "eq",
                "field": "cycle_absent",
                "value": "yes"
              }
            ]
          }
        },
        {
          "id": "hormonal_hirsutism",
          "category": "Clinical Evaluation",
          "label": "Hirsutism Severity (excess facial/body hair on chest, chin, abdomen)",
          "reference": "Ferriman-Gallwey score < 8 (None)",
          "fields": [
            {
              "key": "hirsutism_severity",
              "label": "Hirsutism severity",
              "type": "select",
              "options": [
                "None",
                "Mild",
                "Severe"
              ]
            }
          ],
          "rule": {
            "op": "in",
            "field": "hirsutism_severity",
            "values": [
              "Mild",
              "Severe"
            ]
          }
        },
        {
          "id": "hormonal_alopecia",
          "category": "Clinical Evaluation",
          "label": "Pattern Hair Loss / Androgenic Alopecia (scalp thinning)",
          "reference": "Absence of hair thinning",
          "fields": [
            {
              "key": "alopecia",
              "label": "Scalp thinning / pattern hair loss?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "alopecia",
            "value": "yes"
          }
        },
        {
          "id": "hormonal_acne",
          "category": "Clinical Evaluation",
          "label": "Acne Characteristics (cystic, jawline, adult-onset)",
          "reference": "Clear skin / absence of inflammatory acne",
          "fields": [
            {
              "key": "sym_acne",
              "label": "Cystic / jawline / adult-onset acne?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "sym_acne",
            "value": "yes"
          },
          "shared_field": "sym_acne"
        },
        {
          "id": "hormonal_ultrasound",
          "category": "Clinical Evaluation",
          "label": "Pelvic Ultrasound Findings (polycystic ovary morphology)",
          "reference": "< 20 follicles per ovary, volume < 10 ml",
          "fields": [
            {
              "key": "follicle_count",
              "label": "Follicle count (per ovary)",
              "type": "number"
            },
            {
              "key": "ovarian_volume_ml",
              "label": "Ovarian volume",
              "type": "number",
              "unit": "ml"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "gte",
                "field": "follicle_count",
                "value": 20
              },
              {
                "op": "gte",
                "field": "ovarian_volume_ml",
                "value": 10
              }
            ]
          }
        },
        {
          "id": "hormonal_total_testosterone",
          "category": "Biochemical Evaluation",
          "label": "Total Testosterone",
          "reference": "20-45 ng/dL",
          "fields": [
            {
              "key": "total_testosterone",
              "label": "Total Testosterone",
              "type": "number",
              "unit": "ng/dL"
            }
          ],
          "rule": {
            "op": "outside",
            "field": "total_testosterone",
            "range": [
              20,
              45
            ]
          }
        },
        {
          "id": "hormonal_free_testosterone",
          "category": "Biochemical Evaluation",
          "label": "Free Testosterone",
          "reference": "0.1-0.85 ng/dL",
          "fields": [
            {
              "key": "free_testosterone",
              "label": "Free Testosterone",
              "type": "number",
              "unit": "ng/dL",
              "min": 0,
              "step": 0.01
            }
          ],
          "rule": {
            "op": "outside",
            "field": "free_testosterone",
            "range": [
              0.1,
              0.85
            ]
          }
        },
        {
          "id": "hormonal_lh_fsh",
          "category": "Biochemical Evaluation",
          "label": "LH to FSH Ratio",
          "reference": "~1:1 (LH:FSH > 2:1 indicates Hormonal)",
          "fields": [
            {
              "key": "lh_fsh_ratio",
              "label": "LH:FSH ratio",
              "type": "number",
              "min": 0,
              "step": 0.1
            }
          ],
          "rule": {
            "op": "gte",
            "field": "lh_fsh_ratio",
            "value": 2
          }
        },
        {
          "id": "hormonal_shbg",
          "category": "Biochemical Evaluation",
          "label": "Sex Hormone-Binding Globulin (SHBG)",
          "reference": "40-100 nmol/L",
          "fields": [
            {
              "key": "shbg",
              "label": "SHBG",
              "type": "number",
              "unit": "nmol/L"
            }
          ],
          "rule": {
            "op": "outside",
            "field": "shbg",
            "range": [
              40,
              100
            ]
          }
        },
        {
          "id": "hormonal_post_pill",
          "category": "Root Cause Analysis",
          "label": "History of Post-Pill Amenorrhea or Synthetic Hormone Use",
          "reference": "Natural cycle resumption 3-6 months post-pill",
          "fields": [
            {
              "key": "post_pill_amenorrhea",
              "label": "History of post-pill amenorrhea / synthetic hormone use?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "post_pill_amenorrhea",
            "value": "yes"
          }
        }
      ]
    },
    "inflammatory": {
      "label": "Inflammatory PCOS (Immune / Gut-Driven)",
      "source": "Section 2, Table 3",
      "questions": [
        {
          "id": "inflammatory_acne",
          "category": "Clinical Evaluation",
          "label": "Acne Characteristics (cystic, jawline, adult-onset)",
          "reference": "Clear skin / absence of inflammatory acne",
          "fields": [
            {
              "key": "sym_acne",
              "label": "Cystic / jawline / adult-onset acne?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "sym_acne",
            "value": "yes"
          },
          "shared_field": "sym_acne"
        },
        {
          "id": "inflammatory_joint_pain",
          "category": "Clinical Evaluation",
          "label": "Joint Pain, Unexplained Swelling, or Food Sensitivities",
          "reference": "Absence of chronic inflammatory symptoms",
          "fields": [
            {
              "key": "joint_pain",
              "label": "Joint pain, unexplained swelling, or food sensitivities?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "joint_pain",
            "value": "yes"
          }
        },
        {
          "id": "inflammatory_hscrp",
          "category": "Biochemical Evaluation",
          "label": "High-Sensitivity C-Reactive Protein (hs-CRP)",
          "reference": "< 1.0 mg/L",
          "fields": [
            {
              "key": "hs_crp",
              "label": "hs-CRP",
              "type": "number",
              "unit": "mg/L",
              "min": 0,
              "step": 0.1
            }
          ],
          "rule": {
            "op": "gte",
            "field": "hs_crp",
            "value": 1.0
          }
        },
        {
          "id": "inflammatory_thyroid",
          "category": "Biochemical Evaluation",
          "label": "Thyroid Panel (TSH, Free T3, Free T4, TPO Antibodies)",
          "reference": "TSH 1.0-2.0 mIU/L; TPO Ab negative",
          "fields": [
            {
              "key": "tsh",
              "label": "TSH",
              "type": "number",
              "unit": "mIU/L",
              "min": 0,
              "step": 0.1
            },
            {
              "key": "tpo_ab_positive",
              "label": "TPO antibodies positive?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "outside",
                "field": "tsh",
                "range": [
                  1.0,
                  2.0
                ]
              },
              {
                "op": "eq",
                "field": "tpo_ab_positive",
                "value": "yes"
              }
            ]
          }
        },
        {
          "id": "inflammatory_vitd_zinc",
          "category": "Biochemical Evaluation",
          "label": "Vitamin D3 (25-OH) & Serum Zinc",
          "reference": "> 40 ng/mL / 90-120 \u00b5g/dL",
          "fields": [
            {
              "key": "vitamin_d3",
              "label": "Vitamin D3 (25-OH)",
              "type": "number",
              "unit": "ng/mL"
            },
            {
              "key": "serum_zinc",
              "label": "Serum Zinc",
              "type": "number",
              "unit": "\u00b5g/dL"
            }
          ],
          "rule": {
            "op": "any",
            "rules": [
              {
                "op": "lt",
                "field": "vitamin_d3",
                "value": 40
              },
              {
                "op": "outside",
                "field": "serum_zinc",
                "range": [
                  90,
                  120
                ]
              }
            ]
          }
        },
        {
          "id": "inflammatory_edc",
          "category": "Root Cause Analysis",
          "label": "Daily EDC Exposure (plastics, pesticides, non-stick, cosmetics)",
          "reference": "Low environmental toxin exposure",
          "fields": [
            {
              "key": "edc_exposure",
              "label": "EDC exposure level",
