  "classification_rules": {
    "primary": "Section 3: phenotype with the highest percentage of positive ticks (out of 10) is the primary/dominant driver.",
    "mixed": "Section 3: if two phenotypes tie for the highest tick count, classify as Mixed/Combination Phenotype requiring a dual-targeted protocol.",
    "override_precedence": "Section 3: a triggered biomarker override confirms its phenotype and can flip the tally-based classification. If overrides for two different phenotypes trigger simultaneously, classify as Mixed/Combination.",
    "biomarker_support_note": "Section 3: '3+ positive findings in key biomarkers' for a phenotype is surfaced as supporting evidence alongside the tally-based result."
  },
