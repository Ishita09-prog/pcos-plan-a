  "overrides": [
    {
      "id": "metabolic_override",
      "phenotype": "metabolic",
      "label": "Fasting Insulin > 10 µIU/mL or HOMA-IR > 2.0",
      "reference": "Confirms Metabolic Phenotype",
      "source": "Section 3, Key Biomarker Priority Overrules, bullet 1",
      "rule": {
        "op": "any",
        "rules": [
          {
            "op": "gt",
            "field": "fasting_insulin",
            "value": 10
          },
          {
            "op": "gt",
            "field": "homa_ir",
            "value": 2.0
          }
        ]
      }
    },
    {
      "id": "adrenal_override",
      "phenotype": "adrenal",
      "label": "Isolated DHEA-S > 350 µg/dL with normal insulin",
      "reference": "Confirms Adrenal Phenotype",
      "source": "Section 3, Key Biomarker Priority Overrules, bullet 2",
      "rule": {
        "op": "all",
        "rules": [
          {
            "op": "gt",
            "field": "dhea_s",
            "value": 350
          },
          {
            "op": "not",
            "rule": {
              "op": "any",
              "rules": [
                {
                  "op": "gt",
                  "field": "fasting_insulin",
                  "value": 10
                },
                {
                  "op": "gt",
                  "field": "homa_ir",
                  "value": 2.0
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "hormonal_override",
      "phenotype": "hormonal",
      "label": "LH:FSH > 2:1 or post-pill amenorrhea",
      "reference": "Confirms Hormonal Phenotype",
      "source": "Section 3, Key Biomarker Priority Overrules, bullet 3",
      "rule": {
        "op": "any",
        "rules": [
          {
            "op": "gt",
            "field": "lh_fsh_ratio",
            "value": 2
          },
          {
            "op": "eq",
            "field": "post_pill_amenorrhea",
            "value": "yes"
          }
        ]
      }
    },
    {
      "id": "inflammatory_override",
      "phenotype": "inflammatory",
      "label": "hs-CRP > 1.5 mg/L or severe IBS/gut dysbiosis",
      "reference": "Confirms Inflammatory Phenotype",
      "source": "Section 3, Key Biomarker Priority Overrules, bullet 4",
      "rule": {
        "op": "any",
        "rules": [
          {
            "op": "gt",
            "field": "hs_crp",
            "value": 1.5
          },
          {
            "op": "eq",
            "field": "gut_dysbiosis_severe",
            "value": "yes"
          }
        ]
      }
    }
  ],
