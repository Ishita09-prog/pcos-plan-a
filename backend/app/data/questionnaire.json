              "High"
            ]
          }
        },
        {
          "id": "inflammatory_heavy_metal",
          "category": "Root Cause Analysis",
          "label": "Heavy Metal or Occupational Chemical Exposures",
          "reference": "No significant chemical exposure",
          "fields": [
            {
              "key": "heavy_metal_exposure",
              "label": "Heavy metal / occupational chemical exposure?",
              "type": "yesno"
            }
          ],
          "rule": {
            "op": "eq",
            "field": "heavy_metal_exposure",
            "value": "yes"
          }
        },
        {
          "id": "inflammatory_gut",
          "category": "Root Cause Analysis",
          "label": "Gut Health Status (bloating, IBS, constipation, dysbiosis)",
          "reference": "Normal daily bowel movements, no bloating",
          "fields": [
            {
              "key": "gut_health_issue",
              "label": "Bloating, IBS, constipation or dysbiosis?",
